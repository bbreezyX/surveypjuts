:{$PORT:80} {
    root * /srv
    encode zstd gzip

    header / Cache-Control "no-cache, must-revalidate"
    header /index.html Cache-Control "no-cache, must-revalidate"
    header /favicon.svg Cache-Control "public, max-age=604800"
    header /custom.js Cache-Control "public, max-age=31536000, immutable"
    header /custom.css Cache-Control "public, max-age=31536000, immutable"
    header /data/* Cache-Control "no-cache, must-revalidate"
    header /images/* Cache-Control "public, max-age=2592000"
    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    header /layers/* Cache-Control "public, max-age=31536000, immutable"
    header /resources/* Cache-Control "public, max-age=31536000, immutable"
    header /styles/* Cache-Control "public, max-age=31536000, immutable"
    header /webfonts/* Cache-Control "public, max-age=31536000, immutable"

    header {
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://mt1.google.com https://*.google.com https://*.gstatic.com; connect-src 'self' https://mt1.google.com https://*.google.com; frame-ancestors 'self'; form-action 'self'"
        Strict-Transport-Security "max-age=31536000"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        Cross-Origin-Opener-Policy "same-origin"
        X-Permitted-Cross-Domain-Policies "none"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }

    file_server
}
